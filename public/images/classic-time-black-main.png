<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 500" width="500" height="500">
  <defs>
    <radialGradient id="dialG" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#1e293b"/>
      <stop offset="100%" stop-color="#020617"/>
    </radialGradient>
  </defs>
  <rect width="500" height="500" fill="#0b0f19" rx="24"/>
  <g transform="translate(150, 40)">
    <!-- Leather Strap -->
    <rect x="70" y="20" width="60" height="380" rx="10" fill="#451a03" stroke="#78350f" stroke-width="2"/>
    <!-- Watch Case -->
    <circle cx="100" cy="210" r="85" fill="#94a3b8" stroke="#cbd5e1" stroke-width="4"/>
    <circle cx="100" cy="210" r="72" fill="url(#dialG)"/>
    <!-- Dial Markers -->
    <circle cx="100" cy="210" r="4" fill="#d97706"/>
    <line x1="100" y1="145" x2="100" y2="155" stroke="#ffffff" stroke-width="3"/>
    <line x1="100" y1="265" x2="100" y2="275" stroke="#ffffff" stroke-width="3"/>
    <line x1="35" y1="210" x2="45" y2="210" stroke="#ffffff" stroke-width="3"/>
    <line x1="155" y1="210" x2="165" y2="210" stroke="#ffffff" stroke-width="3"/>
    <!-- Hands -->
    <line x1="100" y1="210" x2="135" y2="175" stroke="#ffffff" stroke-width="4" stroke-linecap="round"/>
    <line x1="100" y1="210" x2="80" y2="160" stroke="#d97706" stroke-width="2" stroke-linecap="round"/>
    <!-- Brand -->
    <text x="100" y="185" font-family="sans-serif" font-size="9" font-weight="900" text-anchor="middle" fill="#d97706" letter-spacing="1">LAZAROPH</text>
    <text x="100" y="195" font-family="sans-serif" font-size="6" font-weight="700" text-anchor="middle" fill="#94a3b8" letter-spacing="1">QUARTZ</text>
    <text x="100" y="430" font-family="sans-serif" font-size="14" font-weight="800" text-anchor="middle" fill="#ffffff" letter-spacing="3">CLASSIC TIME 01</text>
  </g>
</svg>
