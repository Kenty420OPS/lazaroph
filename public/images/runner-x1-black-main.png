<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 500" width="500" height="500">
  <defs>
    <radialGradient id="bgG" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#1e293b"/>
      <stop offset="100%" stop-color="#0b0f19"/>
    </radialGradient>
    <linearGradient id="bodyG" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#2d3748"/>
      <stop offset="100%" stop-color="#111827"/>
    </linearGradient>
    <linearGradient id="soleG" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#ff3b30"/>
      <stop offset="100%" stop-color="#ff6b6b"/>
    </linearGradient>
  </defs>
  <rect width="500" height="500" fill="url(#bgG)" rx="24"/>
  <g transform="translate(40, 100)">
    <!-- Shadow -->
    <ellipse cx="210" cy="280" rx="180" ry="20" fill="rgba(0,0,0,0.6)" filter="blur(8px)"/>
    <!-- Outsole & Midsole -->
    <path d="M 50 240 C 90 260, 280 265, 390 230 C 400 245, 380 270, 360 275 C 240 280, 80 280, 40 260 Z" fill="url(#soleG)"/>
    <path d="M 55 220 C 120 235, 260 240, 385 210 L 390 230 C 280 265, 90 260, 50 240 Z" fill="#f8fafc"/>
    <!-- Shoe Upper -->
    <path d="M 60 220 C 80 180, 140 140, 190 120 C 230 100, 260 130, 290 160 C 330 190, 360 200, 385 210 C 260 240, 120 235, 55 220 Z" fill="url(#bodyG)" stroke="#374151" stroke-width="2"/>
    <!-- Heel Collar -->
    <path d="M 170 130 C 185 105, 220 95, 240 130 C 220 140, 190 140, 170 130 Z" fill="#ff3b30"/>
    <!-- Laces & Eyelets -->
    <path d="M 210 135 L 260 165 M 225 150 L 275 180 M 240 165 L 290 195" stroke="#94a3b8" stroke-width="4" stroke-linecap="round"/>
    <!-- LAZAROPH Signature Swoop -->
    <path d="M 120 210 Q 220 170 320 205 Q 220 225 120 210 Z" fill="#00e5ff" opacity="0.9"/>
    <!-- Brand text -->
    <text x="210" y="320" font-family="sans-serif" font-size="16" font-weight="900" text-anchor="middle" fill="#ffffff" letter-spacing="4">LAZAROPH RUNNER X1</text>
  </g>
</svg>
