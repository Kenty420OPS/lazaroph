rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS FOR ROLE-BASED ACCESS CONTROL
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role in ['ADMIN', 'SUPER_ADMIN'] ||
        request.auth.token.admin == true ||
        request.auth.token.email.matches('.*@lazaroph[.]com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isOrderOwner() {
      return isAuthenticated() && (
        resource.data.customerEmail == request.auth.token.email ||
        resource.data.customerId == request.auth.uid
      );
    }

    // =========================================================================
    // 1. PRODUCTS & CATALOG (PUBLIC READ, ADMIN-ONLY MUTATIONS)
    // =========================================================================
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // =========================================================================
    // 2. BRANDS DIRECTORY (PUBLIC READ, ADMIN-ONLY MUTATIONS)
    // =========================================================================
    match /brands/{brandId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // =========================================================================
    // 3. FEATURED CATEGORIES & SHOWCASE (PUBLIC READ, ADMIN-ONLY MUTATIONS)
    // =========================================================================
    match /featuredCategories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // =========================================================================
    // 4. ORDERS (CUSTOMER PLACEMENT & TRACKING, ADMIN-ONLY UPDATES & DELETES)
    // =========================================================================
    match /orders/{orderId} {
      allow read: if isAdmin() || isOrderOwner() || request.query.limit <= 10;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 5. CUSTOM JERSEY & SPORTSWEAR ORDERS
    // =========================================================================
    match /customOrders/{customOrderId} {
      allow read: if isAdmin() || isOrderOwner();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 6. CUSTOMER PROFILES (SELF-MANAGE OR ADMIN VIEW/DELETE)
    // =========================================================================
    match /customers/{customerId} {
      allow read: if isAdmin() || isOwner(customerId);
      allow create: if isAuthenticated() && request.auth.uid == customerId;
      allow update: if isAdmin() || isOwner(customerId);
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 7. ADMINISTRATORS DIRECTORY (STRICT ADMIN-ONLY ACCESS)
    // =========================================================================
    match /admins/{adminId} {
      allow read, create, update, delete: if isAdmin();
    }

    // =========================================================================
    // 8. STORE SETTINGS (PUBLIC READ, ADMIN-ONLY CONFIGURATION)
    // =========================================================================
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 9. LIVE SUPPORT CHAT & CONVERSATIONS
    // =========================================================================
    match /chat_messages/{messageId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    match /conversations/{conversationId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }
  }
}
