    <path d="M22 0 C10 0 0 10 0 22 C0 34 10 44 22 44 C27 44 32 42 36 38 L30 32 C28 34 25 35 22 35 C15 35 9 29 9 22 C9 15 15 9 22 9 C27 9 32 12 34 17 L44 14 C40 5 32 0 22 0 Z" transform="translate(0, 2) scale(0.9)"/>
