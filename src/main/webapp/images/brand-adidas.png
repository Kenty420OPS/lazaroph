<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 200" width="300" height="200">
  <rect width="300" height="200" fill="#ffffff" rx="8"/>
  <!-- Adidas 3-Stripes Mountain / Badge -->
  <g transform="translate(150, 85) rotate(-28)">
    <rect x="-45" y="-10" width="16" height="36" rx="2" fill="#000000"/>
    <rect x="-20" y="-24" width="16" height="50" rx="2" fill="#000000"/>
    <rect x="5" y="-38" width="16" height="64" rx="2" fill="#000000"/>
  </g>
  <text x="150" y="165" font-family="'Outfit', sans-serif" font-size="24" font-weight="900" text-anchor="middle" fill="#000000" letter-spacing="3">ADIDAS</text>
</svg>
