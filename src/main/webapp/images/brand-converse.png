<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 110" width="200" height="110">
  <rect width="200" height="110" fill="#ffffff"/>
  <!-- Foot Locker Converse Star-Chevron + CONVERSE text -->
  <g fill="#000000" transform="translate(64, 8) scale(0.72)">
    <!-- Star -->
    <polygon points="26,24 32,38 46,38 35,47 39,61 26,53 13,61 17,47 6,38 20,38"/>
    <!-- Chevron Arrow -->
    <polygon points="50,14 74,38 50,62 62,62 86,38 62,14"/>
  </g>
  <text x="100" y="86" font-family="'Helvetica Neue', 'Arial Black', sans-serif" font-size="16" font-weight="900" text-anchor="middle" fill="#000000" letter-spacing="2">CONVERSE</text>
</svg>
