<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 200" width="300" height="200">
  <rect width="300" height="200" fill="#ffffff" rx="8"/>
  <!-- Vans "Off The Wall" Skateboard Logo -->
  <g transform="translate(150, 75)">
    <path d="M -90 -25 C 0 -40, 0 -40, 90 -25 C 105 0, 105 0, 90 25 C 0 40, 0 40, -90 25 C -105 0, -105 0, -90 -25 Z" fill="#000000"/>
    <path d="M -85 -20 C 0 -35, 0 -35, 85 -20 C 98 0, 98 0, 85 20 C 0 35, 0 35, -85 20 C -98 0, -98 0, -85 -20 Z" fill="#ffffff"/>
    <text x="0" y="8" font-family="'Outfit', sans-serif" font-size="22" font-weight="900" text-anchor="middle" fill="#000000" letter-spacing="3">VANS</text>
  </g>
  <text x="150" y="165" font-family="'Outfit', sans-serif" font-size="14" font-weight="800" text-anchor="middle" fill="#000000" letter-spacing="3">"OFF THE WALL"</text>
</svg>
