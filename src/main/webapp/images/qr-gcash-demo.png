<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400" width="400" height="400">
  <defs>
    <linearGradient id="gcashHeader" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#007dfe"/>
      <stop offset="100%" stop-color="#0056b3"/>
    </linearGradient>
  </defs>
  <rect width="400" height="400" fill="#ffffff" rx="20"/>
  <!-- GCash Top Bar -->
  <rect width="400" height="70" fill="url(#gcashHeader)" rx="20 20 0 0"/>
  <text x="200" y="45" font-family="sans-serif" font-size="20" font-weight="900" text-anchor="middle" fill="#ffffff" letter-spacing="2">GCash QR Ph</text>
  
  <!-- Outer Frame & Corner Markers -->
  <g transform="translate(60, 90)">
    <!-- Top-Left Marker -->
    <rect x="0" y="0" width="60" height="60" fill="#007dfe" rx="8"/>
    <rect x="10" y="10" width="40" height="40" fill="#ffffff" rx="4"/>
    <rect x="20" y="20" width="20" height="20" fill="#007dfe" rx="2"/>

    <!-- Top-Right Marker -->
    <rect x="220" y="0" width="60" height="60" fill="#007dfe" rx="8"/>
    <rect x="230" y="10" width="40" height="40" fill="#ffffff" rx="4"/>
    <rect x="240" y="20" width="20" height="20" fill="#007dfe" rx="2"/>

    <!-- Bottom-Left Marker -->
    <rect x="0" y="160" width="60" height="60" fill="#007dfe" rx="8"/>
    <rect x="10" y="170" width="40" height="40" fill="#ffffff" rx="4"/>
    <rect x="20" y="180" width="20" height="20" fill="#007dfe" rx="2"/>

    <!-- QR Data Patterns -->
    <rect x="80" y="10" width="20" height="20" fill="#111827"/>
    <rect x="120" y="10" width="40" height="20" fill="#111827"/>
    <rect x="180" y="20" width="20" height="40" fill="#111827"/>
    <rect x="20" y="80" width="40" height="20" fill="#111827"/>
    <rect x="80" y="70" width="30" height="30" fill="#111827"/>
    <rect x="130" y="80" width="40" height="40" fill="#007dfe"/>
    <rect x="190" y="90" width="40" height="20" fill="#111827"/>
    <rect x="240" y="80" width="30" height="30" fill="#111827"/>
    <rect x="80" y="130" width="30" height="40" fill="#111827"/>
    <rect x="130" y="140" width="30" height="20" fill="#111827"/>
    <rect x="180" y="130" width="40" height="40" fill="#111827"/>
    <rect x="230" y="130" width="30" height="50" fill="#111827"/>
    <rect x="80" y="190" width="40" height="30" fill="#111827"/>
    <rect x="140" y="180" width="30" height="40" fill="#111827"/>
    <rect x="190" y="190" width="40" height="30" fill="#007dfe"/>
    <rect x="240" y="190" width="30" height="30" fill="#111827"/>
  </g>

  <!-- Bottom Brand Text -->
  <text x="200" y="345" font-family="sans-serif" font-size="13" font-weight="900" text-anchor="middle" fill="#007dfe" letter-spacing="1">LAZAROPH PHILIPPINES</text>
  <text x="200" y="370" font-family="sans-serif" font-size="12" font-weight="700" text-anchor="middle" fill="#64748b">SCAN TO PAY VIA GCASH</text>
</svg>
