<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 500" width="500" height="500">
  <rect width="500" height="500" fill="#0b0f19" rx="24"/>
  <g transform="translate(100, 80)">
    <!-- Shorts Silhouette -->
    <path d="M 80 50 L 220 50 L 250 250 L 170 250 L 150 140 L 130 250 L 50 250 Z" fill="#334155" stroke="#475569" stroke-width="3"/>
    <!-- Waistband & Drawstring -->
    <rect x="75" y="45" width="150" height="20" rx="4" fill="#1e293b"/>
    <line x1="145" y1="65" x2="135" y2="105" stroke="#ff3b30" stroke-width="3"/>
    <line x1="155" y1="65" x2="165" y2="105" stroke="#ff3b30" stroke-width="3"/>
    <!-- Brand Logo on Left Hem -->
    <text x="80" y="235" font-family="sans-serif" font-size="10" font-weight="900" fill="#ffffff" letter-spacing="1">LZPH</text>
    <text x="150" y="300" font-family="sans-serif" font-size="14" font-weight="800" text-anchor="middle" fill="#ffffff" letter-spacing="3">TRAINING SHORTS</text>
  </g>
</svg>
