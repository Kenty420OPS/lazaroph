<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 500" width="500" height="500">
  <rect width="500" height="500" fill="#0b0f19" rx="24"/>
  <g transform="translate(150, 40)">
    <rect x="65" y="20" width="70" height="380" rx="8" fill="#18181b" stroke="#27272a" stroke-width="2"/>
    <!-- Tactical Rugged Bezel -->
    <rect x="25" y="135" width="150" height="150" rx="28" fill="#09090b" stroke="#3f3f46" stroke-width="4"/>
    <!-- Digital LCD -->
    <rect x="50" y="160" width="100" height="100" rx="8" fill="#064e3b" stroke="#10b981" stroke-width="1.5"/>
    <text x="100" y="205" font-family="monospace" font-size="24" font-weight="900" text-anchor="middle" fill="#34d399">10:58</text>
    <text x="100" y="235" font-family="monospace" font-size="14" font-weight="700" text-anchor="middle" fill="#a7f3d0">MON 17</text>
    <text x="100" y="152" font-family="sans-serif" font-size="8" font-weight="900" text-anchor="middle" fill="#71717a">SHOCK RESIST</text>
    <text x="100" y="430" font-family="sans-serif" font-size="14" font-weight="800" text-anchor="middle" fill="#ffffff" letter-spacing="3">SPORT DIGITAL 01</text>
  </g>
</svg>
